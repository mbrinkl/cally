{
  "name": "@cally/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup index.ts --platform node --format esm --out-dir dist --clean",
    "dev": "tsx --env-file=../../.env index.ts",
    "start": "node dist/index.js",
    "server:prod": "cross-env NODE_ENV=production node --env-file=../../.env dist/index.js"
  },
  "dependencies": {
    "@cally/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tsdav": "^2.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  }
}
