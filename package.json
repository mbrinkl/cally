{
  "name": "front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run client\" \"npm run server\"",
    "client": "vite",
    "server": "tsx --env-file=.env srv/index.ts",
    "server:prod": "cross-env NODE_ENV=production tsx --env-file=.env srv/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fullcalendar/icalendar": "^7.0.2",
    "@fullcalendar/react": "^7.0.2",
    "@fullcalendar/rrule": "^7.0.2",
    "express": "^5.2.1",
    "ical.js": "^2.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "temporal-polyfill": "^1.0.3",
    "tsdav": "^2.3.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
